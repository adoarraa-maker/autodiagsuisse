# ── Site ────────────────────────────────────────────────
# URL publique (sans slash final). Utilisée pour success/cancel Stripe
# et les images produit dans Checkout. Ex. https://autodia.ch
SITE_URL=https://autodia.ch

# ── Stripe ──────────────────────────────────────────────
# Dashboard → Developers → API keys → Secret key (sk_live_… ou sk_test_…)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx

# Dashboard → Developers → Webhooks → Add endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── Resend (e-mails) ────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxx

# Expéditeur vérifié chez Resend (domaine autodia.ch recommandé)
EMAIL_FROM=AutoDia Suisse <info@autodia.ch>

# Vous (notification interne) — obligatoire si pas de SUPPLIER_EMAIL
ORDER_NOTIFY_EMAIL=info@autodia.ch

# Fournisseur dropshipping (optionnel — même e-mail structuré)
SUPPLIER_EMAIL=

# true = envoie aussi un e-mail de confirmation au client
SEND_CUSTOMER_CONFIRMATION=false

# ── API fournisseur (optionnel) ─────────────────────────
# Si renseigné, POST JSON de la commande après paiement
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
